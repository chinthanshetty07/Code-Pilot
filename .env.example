# --- Database ---
# Host-side port is 5433, not Postgres's default 5432, because another local
# Postgres was already bound to 5432 on this machine. Change back if that's
# not true for you (also update the "5433:5432" mapping in docker-compose.yml).
DATABASE_URL=postgresql+psycopg://codepilot:codepilot@localhost:5433/codepilot

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- GitHub OAuth & webhooks ---
# Create at https://github.com/settings/developers -> OAuth Apps -> New OAuth App
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:8010/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# --- LLM providers (wired starting Milestone 5) ---
# Two free providers, used for different agent roles instead of sharing one
# rate limit. Groq: console.groq.com -> API Keys (no card). Gemini: same
# key as EMBEDDING_API_KEY below, from https://aistudio.google.com/apikey.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
PLANNER_LLM_PROVIDER=groq

# --- Embeddings provider (wired starting the indexing milestone) ---
# "openai" or "gemini". Get a Gemini key (free tier, no card) at
# https://aistudio.google.com/apikey -- OpenAI needs billing enabled instead.
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001

# --- App ---
SECRET_KEY=change-me-in-production
ENVIRONMENT=development
API_BASE_URL=http://localhost:8010
FRONTEND_URL=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8010
